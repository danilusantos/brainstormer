{
  "name": "brainstormer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"vite\"",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@tldraw/tldraw": "^3.9.0",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.63.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar": "^3.6.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true,
    "esbuild@0.21.5": true
  }
}
